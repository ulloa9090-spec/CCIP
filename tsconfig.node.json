{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "tests/unit/database/**/*",
    "tests/unit/security/**/*",
    "tests/unit/shared/**/*",
    "tests/unit/pdf/**/*",
    "tests/unit/jobs/**/*",
    "tests/unit/retrieval/**/*",
    "tests/unit/ai/**/*",
    "tests/unit/tutor/**/*",
    "tests/eval/**/*",
    "tests/ai-smoke/**/*",
    "tests/unit/diagnostics/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "types": ["electron-vite/node"]
  }
}
