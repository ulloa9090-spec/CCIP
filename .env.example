# Base URL of this app in the current environment — used to build email
# confirmation / password reset links. http://localhost:3000 in dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Development project. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never reference this in a Client Component.
SUPABASE_SERVICE_ROLE_KEY=

# AI provider abstraction (Phase 10). AI_PROVIDER picks the deployment
# default adapter ("anthropic" | "openai" | "local" — "local" is a stub,
# not implemented yet); users can override it per-account in Settings.
# Leave the matching key blank and AI Coach still works — it just shows
# "AI Coach is unavailable right now" instead of a generated reply.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
