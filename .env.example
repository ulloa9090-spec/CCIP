# Base URL of this app in the current environment — used to build email
# confirmation / password reset links. http://localhost:3000 in dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Development project. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never reference this in a Client Component.
SUPABASE_SERVICE_ROLE_KEY=

# AI provider abstraction (activated in Phase 10 — safe to leave unset until then).
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
