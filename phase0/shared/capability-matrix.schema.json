{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boxop.app/schemas/phase0/capability-matrix.schema.json",
  "title": "BoxOp Phase 0 Capability Matrix",
  "description": "Canonical per-device capability record produced by the Phase 0 iOS and Android harnesses. See phase0/shared/CAPABILITY_MATRIX.md for field documentation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "platform",
    "osVersion",
    "deviceModel",
    "harnessVersion",
    "timestamp",
    "cameraAvailable",
    "cameraAuthorizationStatus",
    "arSupported",
    "arSupportDetail",
    "planeDetectionSupported",
    "accelerometerAvailable",
    "gyroscopeAvailable",
    "deviceMotionAvailable",
    "depthSupported",
    "lidarAvailable",
    "tofAvailable",
    "selectedMeasurementStrategy",
    "fallbackStrategy",
    "knownLimitations",
    "rawNotes"
  ],
  "properties": {
    "platform": { "type": "string", "enum": ["ios", "android"] },
    "osVersion": { "type": "string" },
    "deviceModel": { "type": "string" },
    "harnessVersion": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "cameraAvailable": { "type": "boolean" },
    "cameraAuthorizationStatus": { "type": "string" },
    "arSupported": { "type": "boolean" },
    "arSupportDetail": { "type": "string" },
    "planeDetectionSupported": { "type": "boolean" },
    "accelerometerAvailable": { "type": "boolean" },
    "gyroscopeAvailable": { "type": "boolean" },
    "deviceMotionAvailable": { "type": "boolean" },
    "depthSupported": { "type": "boolean" },
    "lidarAvailable": { "type": "boolean" },
    "tofAvailable": { "type": "boolean" },
    "selectedMeasurementStrategy": { "type": "string" },
    "fallbackStrategy": { "type": "string" },
    "knownLimitations": { "type": "string" },
    "rawNotes": { "type": "string" }
  }
}
